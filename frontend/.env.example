# Copy to .env.local and fill in. Never commit .env.local.

# Supabase PostgreSQL, Session pooler string (port 5432). Percent-encode special characters in the password (@ -> %40).
# Enables accounts, the admin panel, reviews and seat locking. Without it the site runs in demo mode.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Razorpay test keys (Dashboard -> Test Mode -> API Keys). Only rzp_test_ keys are accepted.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: a long random string to sign login cookies (otherwise derived from DATABASE_URL).
# AUTH_SECRET=

# Optional: use the separate offline backend/ (SQLite) instead of the website's own API routes.
# Accounts, admin and reviews need DATABASE_URL and are not available through it.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api
