# Copy to .env and adjust if needed.
PORT=4000
# SQLite file, relative to the backend folder
DB_PATH=../database/pickmyseat.db
# Frontend origin allowed to call the API (* = any)
CORS_ORIGIN=http://localhost:3000

# Razorpay TEST keys (Dashboard > Test Mode > Account & Settings > API Keys).
# Only rzp_test_ keys are accepted. Never commit the real .env file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
